# Supabase project settings -> Connect (or Project Settings -> Database)
# Pooled connection (via Supavisor on port 6543) — used at runtime by Prisma Client.
# pgbouncer=true disables prepared statements (required in transaction-pooling mode).
# sslmode=require is required by the pg driver adapter (Prisma 7 no longer negotiates SSL implicitly).
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Direct connection (port 5432) — used by the Prisma CLI (migrate/studio/db push), which needs a non-pooled connection.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_[...]"

# Absolute origin of this app, used to build email-confirmation redirect links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# AI provider for the Research/Planning/Writing/Review/Learning agents and RAG embeddings.
# "gemini" (default) or "ollama" (local model at OLLAMA_BASE_URL).
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# Image sourcing: "unsplash" (default, stock search), "pollinations" (free AI generation)
# or "gemini" (generation; needs billing).
IMAGE_PROVIDER="unsplash"
UNSPLASH_ACCESS_KEY=""
# Optional secret key (sk_...) from https://enter.pollinations.ai/keys. Without it Pollinations
# uses its anonymous endpoint (rate limited, watermarked, ignores POLLINATIONS_MODEL).
POLLINATIONS_API_KEY=""
POLLINATIONS_MODEL="tongyi-mai/z-image-turbo"

# Shared secrets n8n sends in the x-webhook-secret header (min 16 chars each). Generate with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TREND_WEBHOOK_SECRET=""
SCHEDULER_WEBHOOK_SECRET=""
ANALYTICS_WEBHOOK_SECRET=""
