generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// Knowledge Base (Milestone: per-user KB for the later RAG pipeline)
//
// Auth boundary:
// - auth.users (Supabase Auth) lives in the "auth" Postgres schema, which
//   Prisma does not manage and has no model for.
// - Profile.id is NOT app-generated. It is populated by a Postgres trigger
//   fired AFTER INSERT ON auth.users (see prisma/sql/knowledge_base_setup.sql),
//   because Prisma's schema DSL cannot declare a foreign key into a schema
//   it doesn't manage. Prisma app code must only read/update this row,
//   never insert one.
// - Deliberately minimal for this milestone: no denormalized email/name/etc.
//   Those belong to a broader profile-settings feature and can be added
//   later without touching the trigger contract (it only needs to insert
//   `id`).
//
// RLS: every table below gets `ENABLE ROW LEVEL SECURITY` in raw SQL with
// NO permissive policies attached. This app's Next.js server layer — not
// Supabase PostgREST/RLS — is the actual authorization boundary: Prisma
// connects through a privileged Postgres role that bypasses RLS regardless
// of any policies we write, so granular per-row policies here would never
// actually be evaluated. RLS is enabled purely as defense-in-depth (e.g. an
// accidentally-exposed anon/PostgREST path), not as the primary gate. That
// bypass assumption depends on the Postgres role behind DATABASE_URL being
// the table owner (or BYPASSRLS) — see the SQL file for the load-bearing
// detail this implies for the signup trigger too.
//
// pgvector (Milestone 7): rather than an additive `embedding vector(n)`
// column per facet table as originally anticipated here, embeddings live in
// a separate unified `KnowledgeChunk` table (see below) keyed back to
// whichever facet row produced each chunk. Retrieval needs one similarity
// query across every facet at once ("top-k most relevant KB content
// regardless of type"); splitting embeddings across 8 tables would mean 8
// separate similarity searches merged in application code every retrieval
// call, for no benefit since Prisma has no native vector type either way
// (it's `Unsupported("vector(n)")` — raw SQL — regardless of which table
// it's on).
// ─────────────────────────────────────────────────────────────────────────

model Profile {
  /// Same UUID as auth.users.id — set exclusively by the `handle_new_user`
  /// trigger. No @default here on purpose.
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  resume         Resume?
  projects       Project[]
  experiences    Experience[]
  achievements   Achievement[]
  skills         Skill[]
  writingSamples WritingStyleSample[]
  goals          Goal[]
  opinions       Opinion[]

  @@map("profiles")
}

/// A user's single current resume/CV (strict 1:1 — versioning, if ever
/// needed, is a later milestone that relaxes the @unique below).
model Resume {
  id        String @id @default(cuid())
  profileId String @unique @map("profile_id") @db.Uuid

  /// Full resume/CV text (pasted or extracted from an uploaded file) — the
  /// canonical chunk a later RAG milestone will embed.
  content  String  @db.Text
  fileName String? @map("file_name")
  fileUrl  String? @map("file_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // No separate @@index([profileId]): the @unique constraint above already
  // creates a btree index on profile_id, which fully covers FK lookups.
  @@map("resumes")
}

/// One row per project the user wants the AI to know about/draw content from.
model Project {
  id        String    @id @default(cuid())
  profileId String    @map("profile_id") @db.Uuid
  title     String
  role      String?
  techStack String[]  @map("tech_stack")
  url       String?
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  /// Narrative description — the RAG chunk body.
  content String @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("projects")
}

/// One row per job/role in the user's work history.
model Experience {
  id        String    @id @default(cuid())
  profileId String    @map("profile_id") @db.Uuid
  company   String
  title     String
  location  String?
  startDate DateTime? @map("start_date") @db.Date
  /// Null means "current position" (paired with isCurrent below).
  endDate   DateTime? @map("end_date") @db.Date
  isCurrent Boolean   @default(false) @map("is_current")

  /// Narrative description of responsibilities/impact — the RAG chunk body.
  content String @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("experiences")
}

/// Awards, certifications, notable wins, press mentions, etc.
model Achievement {
  id           String    @id @default(cuid())
  profileId    String    @map("profile_id") @db.Uuid
  title        String
  issuer       String?
  achievedDate DateTime? @map("achieved_date") @db.Date

  /// Detail/context/impact — the RAG chunk body.
  content String @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("achievements")
}

/// A discrete skill/competency the user wants reflected in generated content.
model Skill {
  id          String  @id @default(cuid())
  profileId   String  @map("profile_id") @db.Uuid
  name        String
  category    String?
  proficiency String?

  /// Optional short elaboration; app layer may default this to `name` when
  /// empty so the row is still a usable RAG chunk. Nullable because a bare
  /// skill name is meaningful on its own (unlike every other facet's
  /// required `content`, so a future embedding job must fall back to `name`
  /// for rows where this is null rather than doing a blind `SELECT content`).
  content String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // No separate @@index([profileId]): the composite unique index below
  // leads with profile_id, which already covers FK/profile-scoped lookups.
  @@unique([profileId, name])
  @@map("skills")
}

/// Raw samples of the user's own writing (past posts, blog snippets, emails)
/// used by the RAG pipeline to imitate voice/tone.
model WritingStyleSample {
  id        String  @id @default(cuid())
  profileId String  @map("profile_id") @db.Uuid
  title     String?
  /// Freeform label, e.g. "LinkedIn post", "Newsletter", "Email" — no fixed
  /// taxonomy imposed at this stage.
  source    String?

  /// The sample text itself — the RAG chunk body.
  content String @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("writing_style_samples")
}

/// Personal-branding goals ("grow to 10k followers", "land a staff role").
model Goal {
  id         String    @id @default(cuid())
  profileId  String    @map("profile_id") @db.Uuid
  title      String
  /// Freeform, e.g. "Q3 2026", "next 6 months" — no fixed taxonomy imposed.
  timeframe  String?
  targetDate DateTime? @map("target_date") @db.Date

  /// Description of the goal / why it matters — the RAG chunk body.
  content String @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("goals")
}

/// Topics the user has a stated point of view on, for opinion-led content.
model Opinion {
  id        String @id @default(cuid())
  profileId String @map("profile_id") @db.Uuid
  topic     String

  /// The stance/explanation itself — the RAG chunk body.
  content String @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("opinions")
}

// ─────────────────────────────────────────────────────────────────────────
// Milestone 5: Trend Collection
//
// Deliberately NOT scoped to a Profile: a trending topic ("AI agents are
// eating SaaS") is the same fact regardless of which user's pipeline later
// consumes it. Personalizing *which* trends matter to a given user is the
// Research Agent's job (a later milestone that reads this table and scores
// relevance against that user's Knowledge Base) — Trend Collection's only
// job is capturing raw candidates. Keeping it unscoped now avoids having to
// reshape this table (or duplicate rows per user) once that milestone
// lands.
//
// Ingestion: rows arrive via POST /api/webhooks/trends, called by an n8n
// workflow the user runs externally (whatever scraping/API source they
// wire up there — X, LinkedIn, Google Trends, RSS...). That route is the
// only writer of this table other than the status-update actions below.
// ─────────────────────────────────────────────────────────────────────────

enum TrendStatus {
  NEW
  REVIEWED
  DISMISSED
}

model Trend {
  id     String      @id @default(cuid())
  topic  String
  /// Short summary/why-it's-trending blurb from the source, if provided.
  summary String? @db.Text
  sourceName String? @map("source_name")
  sourceUrl  String? @map("source_url")
  /// Free-form relevance/virality score from whatever produced this trend
  /// (n8n's scraper, an API's own ranking, etc.) — no fixed scale imposed,
  /// since the source isn't fixed either.
  score Float?
  /// When the source says this trend appeared/was published, distinct from
  /// `createdAt` (when *this app* ingested it) — the two can differ by
  /// hours/days depending on n8n's run cadence.
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  status TrendStatus @default(NEW)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  researchBrief ResearchBrief?

  @@index([status, createdAt])
  @@map("trends")
}

// ─────────────────────────────────────────────────────────────────────────
// Milestone 6: Research Agent
//
// One ResearchBrief per Trend, triggered manually once a trend is REVIEWED
// ("approved"). Retries re-run in place — status flips back to PROCESSING,
// and the structured fields get overwritten on the next success — rather
// than creating a second brief per trend; a trend has one canonical
// research result at a time. ResearchAttempt below is the audit trail that
// makes retries safe to reason about: every attempt (including ones that
// failed) keeps its own prompt/response/error, so a retry can't silently
// erase evidence of why the previous one failed.
//
// Generation itself is synchronous within a server action (no queue/worker
// infra in this stack yet) — see src/features/research/actions.ts.
// ─────────────────────────────────────────────────────────────────────────

enum ResearchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ResearchBrief {
  id      String @id @default(cuid())
  trendId String @unique @map("trend_id")

  status   ResearchStatus @default(PENDING)
  attempts Int            @default(0)

  /// Which AIProvider implementation actually produced the current
  /// content — recorded per-brief (not just per-attempt) so the UI can
  /// show provenance without joining to the latest attempt.
  provider String?
  model    String?

  executiveSummary    String?  @map("executive_summary") @db.Text
  keyInsights         String[] @map("key_insights")
  marketOpportunities String[] @map("market_opportunities")
  risks               String[]
  statistics          String[]
  contentAngles       String[] @map("content_angles")

  errorMessage String?   @map("error_message") @db.Text
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  trend       Trend             @relation(fields: [trendId], references: [id], onDelete: Cascade)
  attemptLogs ResearchAttempt[]

  @@map("research_briefs")
}

model ResearchAttempt {
  id            String @id @default(cuid())
  researchId    String @map("research_id")
  attemptNumber Int    @map("attempt_number")

  provider String
  model    String
  prompt   String  @db.Text
  response String? @db.Text

  promptTokens     Int? @map("prompt_tokens")
  completionTokens Int? @map("completion_tokens")
  totalTokens      Int? @map("total_tokens")

  succeeded    Boolean
  errorMessage String? @map("error_message") @db.Text

  startedAt   DateTime  @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  researchBrief ResearchBrief @relation(fields: [researchId], references: [id], onDelete: Cascade)

  @@index([researchId])
  @@map("research_attempts")
}

// ─────────────────────────────────────────────────────────────────────────
// Milestone 7: RAG (pgvector)
//
// Unlike Trend/ResearchBrief, KnowledgeChunk IS scoped to a Profile —
// retrieval must never leak one user's Knowledge Base into another's
// generation context.
//
// Populated by a manual "Sync Knowledge Base" action (src/features/rag/
// sync.ts), not automatically on every facet edit — that would require
// hooking all 8 existing facet server actions from Milestone 4, which is
// more coupling than this milestone needs. `sourceType` + `sourceId`
// together identify which facet row a chunk came from, so a resync can
// find-and-replace it; there's no real foreign key here because the source
// varies across 8 different tables.
// ─────────────────────────────────────────────────────────────────────────

enum KnowledgeSourceType {
  RESUME
  PROJECT
  EXPERIENCE
  ACHIEVEMENT
  SKILL
  WRITING_STYLE_SAMPLE
  GOAL
  OPINION
}

model KnowledgeChunk {
  id        String @id @default(cuid())
  profileId String @map("profile_id") @db.Uuid

  sourceType KnowledgeSourceType @map("source_type")
  sourceId   String              @map("source_id")

  content String @db.Text
  /// Prisma has no native vector type — Unsupported() excludes this column
  /// from Prisma's query builder entirely; every read/write to it goes
  /// through raw SQL (see src/features/rag/sync.ts and retrieve.ts). 768
  /// matches GEMINI_EMBEDDING_MODEL's configured outputDimensionality
  /// (gemini-embedding-001 supports 768/1536/3072 — verified against the
  /// live API, not assumed, since Gemini's model lineup moves fast).
  embedding Unsupported("vector(768)")

  embeddingModel String @map("embedding_model")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([sourceType, sourceId])
  @@index([profileId])
  @@map("knowledge_chunks")
}
