generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// Knowledge Base (Milestone: per-user KB for the later RAG pipeline)
//
// Auth boundary:
// - auth.users (Supabase Auth) lives in the "auth" Postgres schema, which
//   Prisma does not manage and has no model for.
// - Profile.id is NOT app-generated. It is populated by a Postgres trigger
//   fired AFTER INSERT ON auth.users (see prisma/sql/knowledge_base_setup.sql),
//   because Prisma's schema DSL cannot declare a foreign key into a schema
//   it doesn't manage. Prisma app code must only read/update this row,
//   never insert one.
// - Deliberately minimal for this milestone: no denormalized email/name/etc.
//   Those belong to a broader profile-settings feature and can be added
//   later without touching the trigger contract (it only needs to insert
//   `id`).
//
// RLS: every table below gets `ENABLE ROW LEVEL SECURITY` in raw SQL with
// NO permissive policies attached. This app's Next.js server layer — not
// Supabase PostgREST/RLS — is the actual authorization boundary: Prisma
// connects through a privileged Postgres role that bypasses RLS regardless
// of any policies we write, so granular per-row policies here would never
// actually be evaluated. RLS is enabled purely as defense-in-depth (e.g. an
// accidentally-exposed anon/PostgREST path), not as the primary gate. That
// bypass assumption depends on the Postgres role behind DATABASE_URL being
// the table owner (or BYPASSRLS) — see the SQL file for the load-bearing
// detail this implies for the signup trigger too.
//
// pgvector (Milestone 7): rather than an additive `embedding vector(n)`
// column per facet table as originally anticipated here, embeddings live in
// a separate unified `KnowledgeChunk` table (see below) keyed back to
// whichever facet row produced each chunk. Retrieval needs one similarity
// query across every facet at once ("top-k most relevant KB content
// regardless of type"); splitting embeddings across 8 tables would mean 8
// separate similarity searches merged in application code every retrieval
// call, for no benefit since Prisma has no native vector type either way
// (it's `Unsupported("vector(n)")` — raw SQL — regardless of which table
// it's on).
// ─────────────────────────────────────────────────────────────────────────

model Profile {
  /// Same UUID as auth.users.id — set exclusively by the `handle_new_user`
  /// trigger. No @default here on purpose.
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  resume         Resume?
  projects       Project[]
  experiences    Experience[]
  achievements   Achievement[]
  skills         Skill[]
  writingSamples WritingStyleSample[]
  goals          Goal[]
  opinions       Opinion[]

  @@map("profiles")
}

/// A user's single current resume/CV (strict 1:1 — versioning, if ever
/// needed, is a later milestone that relaxes the @unique below).
model Resume {
  id        String @id @default(cuid())
  profileId String @unique @map("profile_id") @db.Uuid

  /// Full resume/CV text (pasted or extracted from an uploaded file) — the
  /// canonical chunk a later RAG milestone will embed.
  content  String  @db.Text
  fileName String? @map("file_name")
  fileUrl  String? @map("file_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // No separate @@index([profileId]): the @unique constraint above already
  // creates a btree index on profile_id, which fully covers FK lookups.
  @@map("resumes")
}

/// One row per project the user wants the AI to know about/draw content from.
model Project {
  id        String    @id @default(cuid())
  profileId String    @map("profile_id") @db.Uuid
  title     String
  role      String?
  techStack String[]  @map("tech_stack")
  url       String?
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  /// Narrative description — the RAG chunk body.
  content String @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("projects")
}

/// One row per job/role in the user's work history.
model Experience {
  id        String    @id @default(cuid())
  profileId String    @map("profile_id") @db.Uuid
  company   String
  title     String
  location  String?
  startDate DateTime? @map("start_date") @db.Date
  /// Null means "current position" (paired with isCurrent below).
  endDate   DateTime? @map("end_date") @db.Date
  isCurrent Boolean   @default(false) @map("is_current")

  /// Narrative description of responsibilities/impact — the RAG chunk body.
  content String @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("experiences")
}

/// Awards, certifications, notable wins, press mentions, etc.
model Achievement {
  id           String    @id @default(cuid())
  profileId    String    @map("profile_id") @db.Uuid
  title        String
  issuer       String?
  achievedDate DateTime? @map("achieved_date") @db.Date

  /// Detail/context/impact — the RAG chunk body.
  content String @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("achievements")
}

/// A discrete skill/competency the user wants reflected in generated content.
model Skill {
  id          String  @id @default(cuid())
  profileId   String  @map("profile_id") @db.Uuid
  name        String
  category    String?
  proficiency String?

  /// Optional short elaboration; app layer may default this to `name` when
  /// empty so the row is still a usable RAG chunk. Nullable because a bare
  /// skill name is meaningful on its own (unlike every other facet's
  /// required `content`, so a future embedding job must fall back to `name`
  /// for rows where this is null rather than doing a blind `SELECT content`).
  content String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // No separate @@index([profileId]): the composite unique index below
  // leads with profile_id, which already covers FK/profile-scoped lookups.
  @@unique([profileId, name])
  @@map("skills")
}

/// Raw samples of the user's own writing (past posts, blog snippets, emails)
/// used by the RAG pipeline to imitate voice/tone.
model WritingStyleSample {
  id        String  @id @default(cuid())
  profileId String  @map("profile_id") @db.Uuid
  title     String?
  /// Freeform label, e.g. "LinkedIn post", "Newsletter", "Email" — no fixed
  /// taxonomy imposed at this stage.
  source    String?

  /// The sample text itself — the RAG chunk body.
  content String @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("writing_style_samples")
}

/// Personal-branding goals ("grow to 10k followers", "land a staff role").
model Goal {
  id         String    @id @default(cuid())
  profileId  String    @map("profile_id") @db.Uuid
  title      String
  /// Freeform, e.g. "Q3 2026", "next 6 months" — no fixed taxonomy imposed.
  timeframe  String?
  targetDate DateTime? @map("target_date") @db.Date

  /// Description of the goal / why it matters — the RAG chunk body.
  content String @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("goals")
}

/// Topics the user has a stated point of view on, for opinion-led content.
model Opinion {
  id        String @id @default(cuid())
  profileId String @map("profile_id") @db.Uuid
  topic     String

  /// The stance/explanation itself — the RAG chunk body.
  content String @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("opinions")
}

// ─────────────────────────────────────────────────────────────────────────
// Milestone 5: Trend Collection
//
// Deliberately NOT scoped to a Profile: a trending topic ("AI agents are
// eating SaaS") is the same fact regardless of which user's pipeline later
// consumes it. Personalizing *which* trends matter to a given user is the
// Research Agent's job (a later milestone that reads this table and scores
// relevance against that user's Knowledge Base) — Trend Collection's only
// job is capturing raw candidates. Keeping it unscoped now avoids having to
// reshape this table (or duplicate rows per user) once that milestone
// lands.
//
// Ingestion: rows arrive via POST /api/webhooks/trends, called by an n8n
// workflow the user runs externally (whatever scraping/API source they
// wire up there — X, LinkedIn, Google Trends, RSS...). That route is the
// only writer of this table other than the status-update actions below.
// ─────────────────────────────────────────────────────────────────────────

enum TrendStatus {
  NEW
  REVIEWED
  DISMISSED
}

model Trend {
  id     String      @id @default(cuid())
  topic  String
  /// Short summary/why-it's-trending blurb from the source, if provided.
  summary String? @db.Text
  sourceName String? @map("source_name")
  sourceUrl  String? @map("source_url")
  /// Free-form label from whatever categorized this trend (e.g. the n8n
  /// Trend Collector workflow's keyword-matching step) — no fixed enum
  /// since the taxonomy may evolve with the workflow, not the schema.
  category String?
  /// Free-form relevance/virality score from whatever produced this trend
  /// (n8n's scraper, an API's own ranking, etc.) — no fixed scale imposed,
  /// since the source isn't fixed either.
  score Float?
  /// When the source says this trend appeared/was published, distinct from
  /// `createdAt` (when *this app* ingested it) — the two can differ by
  /// hours/days depending on n8n's run cadence.
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  status TrendStatus @default(NEW)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Research Studio: null for the shared, collected trend pool. Set when a
  /// profile's custom research request created this trend, which makes it
  /// (and its ResearchBrief) private to that profile: shared listings filter
  /// on `profileId: null`, and every action checks ownership.
  profileId String? @map("profile_id") @db.Uuid

  researchBrief ResearchBrief?
  researchRequest ResearchRequest?  @relation("RequestTrend")
  baseForRequests ResearchRequest[] @relation("RequestBaseTrend")

  @@index([status, createdAt])
  @@index([profileId])
  @@map("trends")
}

// ─────────────────────────────────────────────────────────────────────────
// Milestone 6: Research Agent
//
// One ResearchBrief per Trend, triggered manually once a trend is REVIEWED
// ("approved"). Retries re-run in place — status flips back to PROCESSING,
// and the structured fields get overwritten on the next success — rather
// than creating a second brief per trend; a trend has one canonical
// research result at a time. ResearchAttempt below is the audit trail that
// makes retries safe to reason about: every attempt (including ones that
// failed) keeps its own prompt/response/error, so a retry can't silently
// erase evidence of why the previous one failed.
//
// Generation itself is synchronous within a server action (no queue/worker
// infra in this stack yet) — see src/features/research/actions.ts.
// ─────────────────────────────────────────────────────────────────────────

enum ResearchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ResearchBrief {
  id      String @id @default(cuid())
  trendId String @unique @map("trend_id")

  status   ResearchStatus @default(PENDING)
  attempts Int            @default(0)

  /// Which AIProvider implementation actually produced the current
  /// content — recorded per-brief (not just per-attempt) so the UI can
  /// show provenance without joining to the latest attempt.
  provider String?
  model    String?

  executiveSummary    String?  @map("executive_summary") @db.Text
  keyInsights         String[] @map("key_insights")
  marketOpportunities String[] @map("market_opportunities")
  risks               String[]
  statistics          String[]
  contentAngles       String[] @map("content_angles")

  /// Research Studio (sourced briefs only; null/empty for classic briefs).
  /// `evidence` holds the grounded findings with snapshots of the sources
  /// each one cites, so provenance survives later re-discovery.
  whyItMattersNow String?  @map("why_it_matters_now") @db.Text
  audienceFit     String?  @map("audience_fit") @db.Text
  platformFit     String[] @map("platform_fit")
  evidence        Json?

  errorMessage String?   @map("error_message") @db.Text
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  trend       Trend             @relation(fields: [trendId], references: [id], onDelete: Cascade)
  attemptLogs ResearchAttempt[]
  contentPlans ContentPlan[]

  @@map("research_briefs")
}

model ResearchAttempt {
  id            String @id @default(cuid())
  researchId    String @map("research_id")
  attemptNumber Int    @map("attempt_number")

  provider String
  model    String
  prompt   String  @db.Text
  response String? @db.Text

  promptTokens     Int? @map("prompt_tokens")
  completionTokens Int? @map("completion_tokens")
  totalTokens      Int? @map("total_tokens")

  succeeded    Boolean
  errorMessage String? @map("error_message") @db.Text

  startedAt   DateTime  @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  researchBrief ResearchBrief @relation(fields: [researchId], references: [id], onDelete: Cascade)

  @@index([researchId])
  @@map("research_attempts")
}

// ─────────────────────────────────────────────────────────────────────────
// Milestone 7: RAG (pgvector)
//
// Unlike Trend/ResearchBrief, KnowledgeChunk IS scoped to a Profile —
// retrieval must never leak one user's Knowledge Base into another's
// generation context.
//
// Populated by a manual "Sync Knowledge Base" action (src/features/rag/
// sync.ts), not automatically on every facet edit — that would require
// hooking all 8 existing facet server actions from Milestone 4, which is
// more coupling than this milestone needs. `sourceType` + `sourceId`
// together identify which facet row a chunk came from, so a resync can
// find-and-replace it; there's no real foreign key here because the source
// varies across 8 different tables.
// ─────────────────────────────────────────────────────────────────────────

enum KnowledgeSourceType {
  RESUME
  PROJECT
  EXPERIENCE
  ACHIEVEMENT
  SKILL
  WRITING_STYLE_SAMPLE
  GOAL
  OPINION
}

model KnowledgeChunk {
  id        String @id @default(cuid())
  profileId String @map("profile_id") @db.Uuid

  sourceType KnowledgeSourceType @map("source_type")
  sourceId   String              @map("source_id")

  content String @db.Text
  /// Prisma has no native vector type — Unsupported() excludes this column
  /// from Prisma's query builder entirely; every read/write to it goes
  /// through raw SQL (see src/features/rag/sync.ts and retrieve.ts). 768
  /// matches GEMINI_EMBEDDING_MODEL's configured outputDimensionality
  /// (gemini-embedding-001 supports 768/1536/3072 — verified against the
  /// live API, not assumed, since Gemini's model lineup moves fast).
  embedding Unsupported("vector(768)")

  embeddingModel String @map("embedding_model")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([sourceType, sourceId])
  @@index([profileId])
  @@map("knowledge_chunks")
}

// ─────────────────────────────────────────────────────────────────────────
// Milestone 8: Planning Agent
//
// Unlike ResearchBrief (unscoped — a trend's research is the same fact
// for everyone), a ContentPlan IS scoped to a Profile: two users could plan
// two different posts off the same research, using their own Knowledge
// Base/voice/goals. Hence unique on (researchId, profileId), not researchId
// alone. Same retry-in-place + audit-log pattern as Research/ResearchAttempt
// (Milestone 6) — see that block's comment for the full reasoning.
// ─────────────────────────────────────────────────────────────────────────

enum PlanStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ContentFormat {
  SINGLE_POST
  CAROUSEL
  ARTICLE
}

model ContentPlan {
  id         String @id @default(cuid())
  researchId String @map("research_id")
  profileId  String @map("profile_id") @db.Uuid

  status   PlanStatus @default(PENDING)
  attempts Int        @default(0)

  provider String?
  model    String?

  format        ContentFormat?
  selectedAngle String?        @map("selected_angle") @db.Text
  hook          String?        @db.Text
  keyMessage    String?        @map("key_message") @db.Text
  outline       String[]
  toneGuidance  String?        @map("tone_guidance") @db.Text
  callToAction  String?        @map("call_to_action") @db.Text

  /// Campaign targets. LINKEDIN is always handled by Draft/ScheduledPost;
  /// FACEBOOK/INSTAGRAM get a PlatformVariant each (see the end of file).
  platforms Platform[] @default([LINKEDIN])

  errorMessage String?   @map("error_message") @db.Text
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  research    ResearchBrief @relation(fields: [researchId], references: [id], onDelete: Cascade)
  attemptLogs PlanAttempt[]
  draft       Draft?

  @@unique([researchId, profileId])
  @@index([profileId])
  @@map("content_plans")
}

model PlanAttempt {
  id            String @id @default(cuid())
  planId        String @map("plan_id")
  attemptNumber Int    @map("attempt_number")

  provider String
  model    String
  prompt   String  @db.Text
  response String? @db.Text

  promptTokens     Int? @map("prompt_tokens")
  completionTokens Int? @map("completion_tokens")
  totalTokens      Int? @map("total_tokens")

  succeeded    Boolean
  errorMessage String? @map("error_message") @db.Text

  startedAt   DateTime  @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  plan ContentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("plan_attempts")
}

// ─────────────────────────────────────────────────────────────────────────
// Milestone 9: Writing Agent
//
// One Draft per ContentPlan (1:1) — ownership flows through the plan
// (already scoped to a profile), so Draft itself needs no profileId. Same
// retry-in-place + audit-log pattern as Research/Planning.
// ─────────────────────────────────────────────────────────────────────────

enum DraftStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Draft {
  id     String @id @default(cuid())
  planId String @unique @map("plan_id")

  status   DraftStatus @default(PENDING)
  attempts Int         @default(0)

  provider String?
  model    String?

  /// Full post body for SINGLE_POST/ARTICLE. Empty for CAROUSEL, where the
  /// content lives in `slides` instead — one entry per slide.
  content  String?  @db.Text
  slides   String[]
  hashtags String[]

  errorMessage String?   @map("error_message") @db.Text
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  contentPlan ContentPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  attemptLogs DraftAttempt[]
  qualityReview QualityReview?
  imageAsset  ImageAsset?
  scheduledPost ScheduledPost?
  platformVariants PlatformVariant[]

  @@map("drafts")
}

model DraftAttempt {
  id            String @id @default(cuid())
  draftId       String @map("draft_id")
  attemptNumber Int    @map("attempt_number")

  provider String
  model    String
  prompt   String  @db.Text
  response String? @db.Text

  promptTokens     Int? @map("prompt_tokens")
  completionTokens Int? @map("completion_tokens")
  totalTokens      Int? @map("total_tokens")

  succeeded    Boolean
  errorMessage String? @map("error_message") @db.Text

  startedAt   DateTime  @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@map("draft_attempts")
}

// ─────────────────────────────────────────────────────────────────────────
// Milestone 10: Quality Review Agent
//
// 1:1 with Draft — ownership flows through Draft -> ContentPlan -> profile,
// no separate profileId needed. Same retry-in-place + audit-log pattern as
// Research/Planning/Writing. `overallScore` is computed in application code
// as the average of the 5 dimension scores, not asked of the model
// directly — keeps it consistent with the dimensions rather than letting
// the model pick an arbitrary number that might not match them.
// ─────────────────────────────────────────────────────────────────────────

enum ReviewStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReviewVerdict {
  APPROVED
  NEEDS_REVISION
}

model QualityReview {
  id      String @id @default(cuid())
  draftId String @unique @map("draft_id")

  status   ReviewStatus @default(PENDING)
  attempts Int          @default(0)

  provider String?
  model    String?

  verdict         ReviewVerdict?
  overallScore    Int?           @map("overall_score")
  hookScore       Int?           @map("hook_score")
  clarityScore    Int?           @map("clarity_score")
  voiceMatchScore Int?           @map("voice_match_score")
  valueScore      Int?           @map("value_score")
  ctaScore        Int?           @map("cta_score")

  strengths String[]
  feedback  String[]

  errorMessage String?   @map("error_message") @db.Text
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  draft       Draft           @relation(fields: [draftId], references: [id], onDelete: Cascade)
  attemptLogs ReviewAttempt[]

  @@map("quality_reviews")
}

model ReviewAttempt {
  id            String @id @default(cuid())
  reviewId      String @map("review_id")
  attemptNumber Int    @map("attempt_number")

  provider String
  model    String
  prompt   String  @db.Text
  response String? @db.Text

  promptTokens     Int? @map("prompt_tokens")
  completionTokens Int? @map("completion_tokens")
  totalTokens      Int? @map("total_tokens")

  succeeded    Boolean
  errorMessage String? @map("error_message") @db.Text

  startedAt   DateTime  @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  review QualityReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_attempts")
}

// ─────────────────────────────────────────────────────────────────────────
// Milestone 11: Image Generation
//
// 1:1 with Draft — same ownership-flows-through-the-chain reasoning as
// QualityReview. No AI-generation audit fields (prompt/tokens) since the
// real provider (Unsplash) is search-based, not generative — ImageAttempt
// tracks query/result/error instead. IMAGE_PROVIDER=gemini is a scaffold
// for later (needs a billing-enabled Google Cloud project — verified live
// against the API that the free tier for image models is 0, unlike the
// text/embedding models used elsewhere in this app).
// ─────────────────────────────────────────────────────────────────────────

enum ImageStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ImageAsset {
  id      String @id @default(cuid())
  draftId String @unique @map("draft_id")

  status   ImageStatus @default(PENDING)
  attempts Int         @default(0)

  provider String?
  query    String? @db.Text
  url      String? @db.Text
  thumbUrl String? @map("thumb_url") @db.Text

  /// Unsplash's API guidelines require attributing the photographer with a
  /// link back to their profile and to Unsplash — not optional politeness.
  attributionName String? @map("attribution_name")
  attributionUrl  String? @map("attribution_url") @db.Text
  sourceUrl       String? @map("source_url") @db.Text

  errorMessage String?   @map("error_message") @db.Text
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  draft       Draft          @relation(fields: [draftId], references: [id], onDelete: Cascade)
  attemptLogs ImageAttempt[]

  @@map("image_assets")
}

model ImageAttempt {
  id            String @id @default(cuid())
  imageId       String @map("image_id")
  attemptNumber Int    @map("attempt_number")

  provider  String
  query     String  @db.Text
  resultUrl String? @map("result_url") @db.Text
  succeeded Boolean

  errorMessage String? @map("error_message") @db.Text

  startedAt   DateTime  @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  image ImageAsset @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([imageId])
  @@map("image_attempts")
}

// ─────────────────────────────────────────────────────────────────────────
// Milestone 12: Content Calendar + Approval UI
//
// 1:1 with Draft — same ownership-flows-through-the-chain reasoning as
// QualityReview/ImageAsset. No AI here, so no attempt-log table this time:
// this is a plain human decision (approve/reject + pick a date), not a
// generation job. `publishedAt` is set by a later Scheduler milestone, not
// this one — it exists now so that milestone is an additive UPDATE, not a
// reshape.
// ─────────────────────────────────────────────────────────────────────────

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ScheduledPost {
  id      String @id @default(cuid())
  draftId String @unique @map("draft_id")

  approvalStatus  ApprovalStatus @default(PENDING) @map("approval_status")
  scheduledFor    DateTime?      @map("scheduled_for") @db.Timestamptz(6)
  rejectionReason String?        @map("rejection_reason") @db.Text

  approvedAt  DateTime? @map("approved_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  /// Milestone 13: the live LinkedIn post URL, reported back by n8n on
  /// successful publish. Useful for the Analytics milestone to reference
  /// later without a schema change there.
  publishedUrl String? @map("published_url") @db.Text

  /// Milestone 13: set when a GET /api/scheduler/due poll claims this row
  /// for publishing, so a concurrent/overlapping poll doesn't hand the same
  /// post to n8n twice. Cleared on a reported failure so the next poll can
  /// retry it; a claim older than the route's timeout is also treated as
  /// stale and reclaimable (covers an n8n run that crashed mid-publish).
  publishingStartedAt DateTime? @map("publishing_started_at") @db.Timestamptz(6)
  publishAttempts     Int       @default(0) @map("publish_attempts")
  publishError        String?   @map("publish_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  analyticsSnapshots AnalyticsSnapshot[]

  @@map("scheduled_posts")
}

// ─────────────────────────────────────────────────────────────────────────
// Milestone 14: Analytics
//
// Same delegation pattern as Trend Collection (M5) and the Scheduler
// (M13): LinkedIn engagement data isn't something this app fetches
// directly — n8n checks LinkedIn (using the same integration it already
// has for publishing) and pushes snapshots in via a webhook. Time-series,
// not a single mutable row per post, so a later Learning Agent milestone
// can see the growth curve, not just a current count.
// ─────────────────────────────────────────────────────────────────────────

model AnalyticsSnapshot {
  id              String   @id @default(cuid())
  scheduledPostId String   @map("scheduled_post_id")
  capturedAt      DateTime @map("captured_at") @db.Timestamptz(6)

  impressions Int?
  likes       Int?
  comments    Int?
  shares      Int?
  clicks      Int?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  scheduledPost ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)

  @@index([scheduledPostId, capturedAt])
  @@map("analytics_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────
// Milestone 15: Learning Agent
//
// Unlike Research/Planning/Writing/Review (1:1 with a single upstream
// row), a LearningInsight is an aggregate analysis over ALL of a profile's
// published posts at once — there's no single upstream row to be 1:1 with.
// Each "run" is a new row (same row-per-thing pattern as Trend/
// ResearchBrief), not an upsert-in-place, so re-running as more posts get
// published keeps prior reports around for comparison. Retry re-runs the
// same row in place (attempts++); generating fresh insight after new data
// exists creates a new row instead.
// ─────────────────────────────────────────────────────────────────────────

enum LearningStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model LearningInsight {
  id        String @id @default(cuid())
  profileId String @map("profile_id") @db.Uuid

  status   LearningStatus @default(PENDING)
  attempts Int            @default(0)

  provider String?
  model    String?

  summary                 String?  @db.Text
  topPerformingPatterns   String[] @map("top_performing_patterns")
  underperformingPatterns String[] @map("underperforming_patterns")
  recommendations         String[]
  postsAnalyzed           Int      @default(0) @map("posts_analyzed")

  errorMessage String?   @map("error_message") @db.Text
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  attemptLogs LearningAttempt[]

  @@index([profileId, createdAt])
  @@map("learning_insights")
}

model LearningAttempt {
  id            String @id @default(cuid())
  insightId     String @map("insight_id")
  attemptNumber Int    @map("attempt_number")

  provider String
  model    String
  prompt   String  @db.Text
  response String? @db.Text

  promptTokens     Int? @map("prompt_tokens")
  completionTokens Int? @map("completion_tokens")
  totalTokens      Int? @map("total_tokens")

  succeeded    Boolean
  errorMessage String? @map("error_message") @db.Text

  startedAt   DateTime  @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  insight LearningInsight @relation(fields: [insightId], references: [id], onDelete: Cascade)

  @@index([insightId])
  @@map("learning_attempts")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 1: multi-platform variants
//
// LinkedIn stays on Draft/ScheduledPost (and the external publisher), so
// VariantPlatform deliberately has no LINKEDIN value. A variant is
// generated from a completed Draft's campaign. Phase 1 has NO publisher for
// these platforms: approval + scheduledFor only mark a *planned* entry, and
// publishStatus stays NOT_PUBLISHED until a verified publish result is
// recorded by a future integration. `errorMessage` is for generation
// failures (like Draft); `publishError` is reserved for publishing.
// ─────────────────────────────────────────────────────────────────────────

enum Platform {
  LINKEDIN
  FACEBOOK
  INSTAGRAM
}

enum VariantPlatform {
  FACEBOOK
  INSTAGRAM
}

/// PUBLISHING = a claim is in flight. UNCONFIRMED = the request may have
/// reached the platform (timeout / ambiguous response); never retried
/// automatically, only after the user checks the platform.
enum VariantPublishStatus {
  NOT_PUBLISHED
  PUBLISHED
  FAILED
  PUBLISHING
  UNCONFIRMED
}

model PlatformVariant {
  id String @id @default(cuid())
  /// Denormalized from Draft -> ContentPlan so every query can scope by
  /// profile directly; actions still verify the parent chain.
  profileId String          @map("profile_id") @db.Uuid
  draftId   String          @map("draft_id")
  platform  VariantPlatform

  status   DraftStatus @default(PENDING)
  attempts Int         @default(0)

  provider String?
  model    String?

  content  String? @db.Text
  hashtags String[]
  /// True once the user has hand-edited the generated text.
  edited   Boolean @default(false)

  errorMessage String?   @map("error_message") @db.Text
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)

  approvalStatus  ApprovalStatus @default(PENDING) @map("approval_status")
  scheduledFor    DateTime?      @map("scheduled_for") @db.Timestamptz(6)
  rejectionReason String?        @map("rejection_reason") @db.Text
  approvedAt      DateTime?      @map("approved_at") @db.Timestamptz(6)

  publishStatus VariantPublishStatus @default(NOT_PUBLISHED) @map("publish_status")
  publishedAt   DateTime?            @map("published_at") @db.Timestamptz(6)
  publishedUrl  String?              @map("published_url") @db.Text
  publishError  String?              @map("publish_error") @db.Text

  /// Phase 2 (Meta publishing). `mediaUrl` is a stable public HTTPS JPEG
  /// prepared at approval time from `mediaSourceUrl` (the ImageAsset url it
  /// was derived from); `igContainerId` lets an interrupted Instagram
  /// publish resume instead of creating a second container.
  includeImage        Boolean   @default(true) @map("include_image")
  linkUrl             String?   @map("link_url") @db.Text
  mediaUrl            String?   @map("media_url") @db.Text
  mediaSourceUrl      String?   @map("media_source_url") @db.Text
  connectionId        String?   @map("connection_id")
  targetAccountId     String?   @map("target_account_id")
  publishedPostId     String?   @map("published_post_id")
  publishAttempts     Int       @default(0) @map("publish_attempts")
  publishingStartedAt DateTime? @map("publishing_started_at") @db.Timestamptz(6)
  igContainerId       String?   @map("ig_container_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  draft       Draft            @relation(fields: [draftId], references: [id], onDelete: Cascade)
  attemptLogs VariantAttempt[]
  publishLogs VariantPublishAttempt[]
  connection  MetaConnection?         @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@unique([draftId, platform])
  @@index([profileId, scheduledFor])
  @@map("platform_variants")
}

model VariantAttempt {
  id            String @id @default(cuid())
  variantId     String @map("variant_id")
  attemptNumber Int    @map("attempt_number")

  provider String
  model    String
  prompt   String  @db.Text
  response String? @db.Text

  promptTokens     Int? @map("prompt_tokens")
  completionTokens Int? @map("completion_tokens")
  totalTokens      Int? @map("total_tokens")

  succeeded    Boolean
  errorMessage String? @map("error_message") @db.Text

  startedAt   DateTime  @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  variant PlatformVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("variant_attempts")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 2: Meta (Facebook Pages + Instagram) publishing
//
// One connection per profile. Tokens are AES-256-GCM encrypted by
// src/lib/crypto/token-crypto.ts before they reach this table and are never
// returned to the browser. The long-lived user token (~60 days) is kept only
// to re-list Pages; a Page token derived from it does not expire but is
// invalidated by password changes, role removal or app de-authorization.
// ─────────────────────────────────────────────────────────────────────────

enum MetaConnectionStatus {
  CONNECTED
  NEEDS_REAUTH
}

enum PublishOutcome {
  PUBLISHED
  FAILED
  UNCONFIRMED
  PENDING
}

model MetaConnection {
  id        String @id @default(cuid())
  profileId String @unique @map("profile_id") @db.Uuid

  status       MetaConnectionStatus @default(CONNECTED)
  metaUserId   String               @map("meta_user_id")
  metaUserName String?              @map("meta_user_name")

  userTokenEnc       String    @map("user_token_enc") @db.Text
  userTokenExpiresAt DateTime? @map("user_token_expires_at") @db.Timestamptz(6)
  grantedScopes      String[]  @map("granted_scopes")
  declinedScopes     String[]  @map("declined_scopes")

  pageId             String? @map("page_id")
  pageName           String? @map("page_name")
  pageTokenEnc       String? @map("page_token_enc") @db.Text
  instagramAccountId String? @map("instagram_account_id")
  instagramUsername  String? @map("instagram_username")

  lastError String? @map("last_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  variants PlatformVariant[]

  @@map("meta_connections")
}

/// Audit row per publish step. Holds only sanitized outcome data (never
/// tokens or raw provider bodies).
model VariantPublishAttempt {
  id            String @id @default(cuid())
  variantId     String @map("variant_id")
  attemptNumber Int    @map("attempt_number")

  step            String
  outcome         PublishOutcome
  targetAccountId String?        @map("target_account_id")
  platformPostId  String?        @map("platform_post_id")
  errorCategory   String?        @map("error_category")
  errorCode       Int?           @map("error_code")
  errorSubcode    Int?           @map("error_subcode")
  httpStatus      Int?           @map("http_status")
  message         String?        @db.Text
  traceId         String?        @map("trace_id")

  startedAt   DateTime  @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  variant PlatformVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("variant_publish_attempts")
}

// ─────────────────────────────────────────────────────────────────────────
// Research Studio: trend-to-post research with real sources
//
// Profile-owned. A request holds the user's prompt and creative preferences
// (never stored on the shared Trend/ResearchBrief), the sources discovered
// through real search APIs, and an audit row per discovery attempt. When the
// user generates the brief, a PRIVATE Trend (profileId set) + ResearchBrief
// are created so the existing plan/write/review/image/variant stages run
// unchanged; `trendId` links back for provenance.
// ─────────────────────────────────────────────────────────────────────────

model ResearchRequest {
  id        String @id @default(cuid())
  profileId String @map("profile_id") @db.Uuid

  prompt        String     @db.Text
  timeframeDays Int        @default(7) @map("timeframe_days")
  audience      String?    @db.Text
  industry      String?
  angle         String?    @db.Text
  purpose       String?    @db.Text
  tone          String?
  instructions  String?    @db.Text
  callToAction  String?    @map("call_to_action") @db.Text
  /// Only when true may writers put source links into posts.
  includeLinks  Boolean    @default(false) @map("include_links")
  platforms     Platform[] @default([LINKEDIN])

  /// The shared trend the user started from, if any.
  baseTrendId String? @map("base_trend_id")
  /// The private trend created for the brief.
  trendId     String? @unique @map("trend_id")
  focusTitle  String? @map("focus_title") @db.Text

  discoveryStatus   ResearchStatus @default(PENDING) @map("discovery_status")
  discoveryAttempts Int            @default(0) @map("discovery_attempts")
  discoveryError    String?        @map("discovery_error") @db.Text
  discoveredAt      DateTime?      @map("discovered_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  baseTrend     Trend?                     @relation("RequestBaseTrend", fields: [baseTrendId], references: [id], onDelete: SetNull)
  trend         Trend?                     @relation("RequestTrend", fields: [trendId], references: [id], onDelete: SetNull)
  sources       ResearchSource[]
  discoveryLogs ResearchDiscoveryAttempt[]

  @@index([profileId, createdAt])
  @@map("research_requests")
}

/// A source exactly as a search provider returned it (validated, cleaned of
/// markup, deduplicated). Nothing here is generated by an LLM.
model ResearchSource {
  id        String @id @default(cuid())
  requestId String @map("request_id")
  profileId String @map("profile_id") @db.Uuid

  provider      String
  title         String    @db.Text
  publisher     String?
  url           String    @db.Text
  /// e.g. the Hacker News discussion for a linked article.
  discussionUrl String?   @map("discussion_url") @db.Text
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  retrievedAt   DateTime  @map("retrieved_at") @db.Timestamptz(6)
  snippet       String?   @db.Text
  /// Published within the request's timeframe. Undated sources are never
  /// counted as recent.
  isRecent      Boolean   @default(false) @map("is_recent")
  selected      Boolean   @default(false)
  dedupeKey     String    @map("dedupe_key")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  request ResearchRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, dedupeKey])
  @@index([requestId])
  @@map("research_sources")
}

model ResearchDiscoveryAttempt {
  id            String @id @default(cuid())
  requestId     String @map("request_id")
  attemptNumber Int    @map("attempt_number")

  queries         String[]
  /// Per provider: { ok, count, error? } (sanitized, no credentials).
  providerResults Json     @map("provider_results")
  sourceCount     Int      @map("source_count")

  /// Query extraction (LLM) audit; null when the deterministic fallback ran.
  provider String?
  model    String?
  prompt   String? @db.Text
  response String? @db.Text

  succeeded    Boolean
  errorMessage String? @map("error_message") @db.Text

  startedAt   DateTime  @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  request ResearchRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("research_discovery_attempts")
}
